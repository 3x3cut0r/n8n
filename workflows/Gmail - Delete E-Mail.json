    {
      "parameters": {
        "jsCode": "const raw = $json || {};\n\nconst messageId = typeof raw.messageId === 'string' ? raw.messageId.trim() : '';\nconst threadId = typeof raw.threadId === 'string' ? raw.threadId.trim() : '';\nconst from = typeof raw.from === 'string' ? raw.from.trim() : '';\nconst subject = typeof raw.subject === 'string' ? raw.subject.trim() : '';\nconst snippet = typeof raw.snippet === 'string' ? raw.snippet.trim() : '';\nconst text = typeof raw.text === 'string' ? raw.text : '';\n\n// Caller-supplied read flag. Absent (undefined) means: use the workflow default.\n// String forms are expected because executeWorkflow can deliver booleans as strings.\nlet markAsRead;\nif (typeof raw.markAsRead === 'boolean') {\n  markAsRead = raw.markAsRead;\n} else if (typeof raw.markAsRead === 'string') {\n  const flag = raw.markAsRead.trim().toLowerCase();\n  if (flag === 'true') markAsRead = true;\n  else if (flag === 'false') markAsRead = false;\n}\n\nconst error = messageId ? '' : 'Input field messageId is required and must be a non-empty string.';\n\nreturn [{\n  json: {\n    messageId,\n    threadId,\n    from,\n    subject,\n    snippet,\n    text,\n    markAsRead,\n    okToDelete: !error,\n    error\n  }\n}];"
      },
