      "parameters": {
        "jsCode": "const item = $json || {};\nconst cfg = $('Set mark as read default').first().json || {};\n\nconst failure = item.error;\nlet errorMessage;\nif (failure && typeof failure === 'object') {\n  errorMessage = failure.message || failure.description || failure.name || JSON.stringify(failure);\n} else if (typeof failure === 'string' && failure.trim() !== '') {\n  errorMessage = failure.trim();\n} else if (typeof item.message === 'string' && item.message.trim() !== '') {\n  errorMessage = item.message.trim();\n} else {\n  errorMessage = 'Node failed without error details.';\n}\n\n// Best effort: mark-as-read problems must not block the trash move,\n// so do not throw. Report the problem in the result instead.\nreturn [{\n  json: {\n    ok: false,\n    action: 'markAsRead',\n    messageId: cfg.messageId || null,\n    statusCode: null,\n    response: {\n      error: errorMessage\n    }\n  }\n}];"
