    {
      "parameters": {
        "jsCode": "const response = $json || {};\nconst statusCode = Number(response.statusCode || 0) || null;\nconst hasError = !!response.error || !!response.message;\nconst ok = !hasError && (statusCode === null || (statusCode >= 200 && statusCode < 300));\n\n// Detect the branch that ran: after a successful mark-as-read the Gmail node\n// returns the message with UNREAD removed, otherwise it is absent.\nlet markAsReadDone = false;\ntry {\n  const labels = $('Mark Gmail message as read').first().json.labelIds;\n  markAsReadDone = Array.isArray(labels) && !labels.includes('UNREAD');\n} catch (error) {\n  markAsReadDone = false;\n}\n\nreturn [{\n  json: {\n    ok,\n    action: 'trash',\n    messageId: $('Normalize and validate input').item.json.messageId || null,\n    markAsRead: markAsReadDone,\n    statusCode,\n    response\n  }\n}];"
      },
