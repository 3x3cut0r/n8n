    {
      "parameters": {
        "jsCode": "// Parse the original EML (IMAP download) into an import payload.\n// Header values are unfolded (continuation lines start with whitespace).\nfunction headerBlock(eml) {\n  const cut = eml.indexOf('\\r\\n\\r\\n');\n  const end = cut >= 0 ? cut : eml.indexOf('\\n\\n');\n  return end >= 0 ? eml.slice(0, end) : eml;\n}\n\nfunction parseHeaders(block) {\n  const lines = block.split(/\\r?\\n/);\n  const out = {};\n  let current = null;\n  for (const line of lines) {\n    if (/^[ \\t]/.test(line) && current) {\n      out[current] += ' ' + line.trim();\n      continue;\n    }\n    const idx = line.indexOf(':');\n    if (idx > 0) {\n      current = line.slice(0, idx).trim().toLowerCase();\n      out[current] = line.slice(idx + 1).trim();\n    }\n  }\n  return out;\n}\n\nfunction fnv1a64(str) {\n  let hash = 0xcbf29ce484222325n;\n  const prime = 0x100000001b3n;\n  const mask = 0xffffffffffffffffn;\n  for (let i = 0; i < str.length; i++) {\n    hash ^= BigInt(str.charCodeAt(i));\n    hash = (hash * prime) & mask;\n  }\n  return hash.toString(16).padStart(16, '0');\n}\n\nreturn $input.all().map((item, index) => {\n  const eml = String(item.json.emlContent || '');\n  const block = headerBlock(eml);\n  const h = parseHeaders(block);\n  const messageId = String(h['message-id'] || '');\n  const key = messageId ? messageId.toLowerCase() : `sha:${fnv1a64(block)}`;\n  const rawB64 = Buffer.from(eml, 'utf8')\n    .toString('base64')\n    .replace(/\\+/g, '-')\n    .replace(/\\//g, '_')\n    .replace(/=+$/, '');\n  return {\n    json: {\n      messageKey: key,\n      messageId,\n      subject: String(h.subject || ''),\n      sender: String(h.from || ''),\n      mailDate: h.date ? new Date(h.date).toISOString() : '',\n      sizeBytes: Buffer.byteLength(eml, 'utf8'),\n      sourceUid: String(item.json.uid ?? ''),\n      rawB64,\n    },\n    pairedItem: { item: index },\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        -160
      ],
      "id": "deb3eeea-ea75-4f19-8b3b-0a83b7cd953d",
      "name": "Payload INBOX"
    },
