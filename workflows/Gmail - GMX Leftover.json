          "mode": "name",
          "value": "={{ $('Config').first().json.dataTableName }}"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "messageKey",
              "keyValue": "={{ $json.messageKey }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
