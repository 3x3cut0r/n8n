    {
      "parameters": {
        "jsCode": "// Turn one IMAP list result into import candidates for the inbox branch.\n// mailboxPath is set by the IMAP node, so the folder is taken from the item.\nconst cfg = $('Config').first().json;\nconst mailbox = cfg.inboxMailbox;\nreturn $input.all()\n  .filter((item) => item.json && item.json.uid)\n  .map((item) => {\n  const env = item.json.envelope || {};\n  const from = Array.isArray(env.from) && env.from.length ? env.from[0] : {};\n  const fromText = [from.name, from.address].filter(Boolean).join(' ') || '';\n  const messageId = String(env.messageId || '').trim();\n  return {\n    json: {\n      mailbox,\n      uid: String(item.json.uid ?? ''),\n      messageId,\n      // Same key format as the trigger workflows so both paths share the dedupe table.\n      // Fallback keeps re-runs of the same leftover stable when a mail has no Message-ID.\n      messageKey: messageId ? messageId.toLowerCase() : `sha:uid:${mailbox}:${item.json.uid}`, \n      subject: String(env.subject || ''),\n      sender: fromText,\n      mailDate: env.date ? new Date(env.date).toISOString() : '',\n    },\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        -160
      ],
      "id": "d709a674-913d-4cb2-8fa6-70d1d1b82715",
      "name": "Targets INBOX"
    },
