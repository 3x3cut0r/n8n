        "jsCode": "const rows = [];\nfor (const item of $input.all()) {\n  const e = item.json?.error;\n  const msg = typeof e === 'string' ? e : e?.message || e?.description || JSON.stringify(e ?? {});\n  rows.push(`${item.json?.sourceUid || 'unknown'}: ${msg}`);\n}\nthrow new Error('GMX-Loeschung fehlgeschlagen (INBOX): ' + rows.join(' | '));\n"
