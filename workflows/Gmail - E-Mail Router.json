    {
      "parameters": {
        "jsCode": "const input = $json || {};\nconst settings = $('Settings').first().json;\n\nconst rawFrom = typeof input.from === 'string' ? input.from.trim() : '';\nconst senderMatch = rawFrom.match(/<([^>]+)>/);\nconst sender = (senderMatch?.[1] || rawFrom).trim().toLowerCase();\n\nconst subjectLower = (typeof input.subject === 'string' ? input.subject : '').toLowerCase();\n\n// Deterministic rules first: defined senders and subject keywords skip the AI step.\nconst newsletterKeywords = String(settings.newsletterKeywords || '')\n  .split(',')\n  .map((keyword) => keyword.trim().toLowerCase())\n  .filter(Boolean);\nconst hasNewsletterSubject = newsletterKeywords.some((keyword) => subjectLower.includes(keyword));\n\nconst isAirbusSender = sender === 'noreply@mypayslip.airbus.com';\n\nlet route = {\n  category: 'none',\n  workflowId: '',\n  workflowName: ''\n};\n\nlet classification = {\n  category: 'none',\n  confidence: 1,\n  reason: 'No routing rule matched'\n};\n\nlet routeLabel = 'No Route';\nlet aiDecisionNeeded = true;\n\nconst output = {\n  ...input\n};\n\nif (isAirbusSender) {\n  route = {\n    category: 'airbus_mypayslip',\n    workflowId: 'DwMi5ywRbXvxyNVN',\n    workflowName: 'Airbus - MyPayslip'\n  };\n  classification = {\n    category: 'airbus_mypayslip',\n    confidence: 1,\n    reason: 'Matched sender noreply@mypayslip.airbus.com'\n  };\n  routeLabel = 'Airbus';\n  aiDecisionNeeded = false;\n} else if (hasNewsletterSubject) {\n  route = {\n    category: 'newsletter',\n    workflowId: '3O6R9JybPJWyeyzF',\n    workflowName: 'Gmail - Delete E-Mail'\n  };\n  classification = {\n    category: 'newsletter',\n    confidence: 1,\n    reason: 'Matched newsletter keyword in subject'\n  };\n  routeLabel = 'Newsletter';\n  aiDecisionNeeded = false;\n}\n\nreturn [{\n  json: {\n    ...output,\n    sender,\n    classification,\n    route,\n    routeLabel,\n    aiDecisionNeeded,\n    shouldExecuteSubworkflow: !!route.workflowId\n  }\n}];"
      },
