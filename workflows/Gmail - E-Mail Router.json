        "jsCode": "const data = (() => {\n  try {\n    return $('Build AI classification result').first().json || {};\n  } catch (error) {\n    return $('Parse and resolve route').first().json || {};\n  }\n})();\nconst response = $json || {};\nconst failure = response.error;\nconst errorMessage = failure && typeof failure === 'object'\n  ? (failure.message || failure.description || JSON.stringify(failure))\n  : (typeof failure === 'string' && failure.trim() !== '' ? failure.trim() : '');\n\nreturn [{\n  json: {\n    ok: !errorMessage,\n    action: 'route',\n    messageId: data.messageId || null,\n    threadId: data.threadId || null,\n    classification: data.classification || null,\n    route: data.route || null,\n    executed: !errorMessage,\n    error: errorMessage || null,\n    response\n  }\n}];"
