      "name": "Check Gmail credential",
      "webhookId": "62a11c94-413c-4aca-a8a6-2e34455ef511",
      "alwaysOutputData": true,
      "credentials": {
        "gmailOAuth2": {
          "id": "TbMOUQL6WmlDF4Be",
          "name": "Gmail account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const checkedAt = new Date().toISOString();\nconst response = $json || {};\n\nreturn [{\n  json: {\n    ok: true,\n    credential: 'Gmail account',\n    checkedAt,\n    messageId: response.id || null\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        96,
        800
      ],
      "id": "b7596b68-cf00-4f5c-949e-c8e1f11dfbe2",
      "name": "Build success result"
    },
    {
      "parameters": {
        "jsCode": "const checkedAt = new Date().toISOString();\nconst response = $json || {};\nconst rawError = response.error || response.message || response.description || response;\nconst errorText = typeof rawError === 'string'\n  ? rawError\n  : JSON.stringify(rawError).slice(0, 700);\n\nreturn [{\n  json: {\n    message: `[Gmail]\\nGoogle credential expired\\nCredential: Gmail account\\nChecked at: ${checkedAt}\\nError: ${errorText || 'Gmail credential check failed'}`,\n    recipient: '',\n    parseMode: '',\n    disableNotification: false,\n    disableWebPagePreview: true\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
