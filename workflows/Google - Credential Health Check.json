  "name": "Google - Credential Health Check",
  "nodes": [
    {
      "parameters": {
        "content": "# Google - Credential Health Check\n\nChecks the Gmail OAuth2 credential twice daily at 06:00 and 18:00.\n\nScope:\n- Tests the existing Gmail credential with a harmless read-only Gmail request.\n- Sends a Telegram alert only when the Gmail request fails, which usually means the Google OAuth credential needs reconnecting.\n\nPrerequisites:\n- Gmail OAuth2 credential: `Gmail account`\n- Sub-workflow: `Telegram - Send Message`\n- Telegram default recipient configured in `Telegram - Send Message`",
        "height": 320,
        "width": 672
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
